generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR
  DG
}

enum CheckInStatus {
  ON_TIME
  LATE
}

enum CheckOutStatus {
  MANUAL
  AUTO
}

enum FinalStatus {
  PRESENT
  ABSENT
  PERMISSION
  MISSION
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Structure {
  SCPB
  AFREXIA
  GOLDENBEANS
}

/** Type de demande (formulaire officiel RH). */
enum LeaveAbsenceCategory {
  AUTORISATION_COURTE
  CONGES_ANNUELS
  CONGES_EXCEPTIONNEL
  EVENEMENT_FAMILIAL
  MALADIE
  FORMATION
  RTT_RECUPERATION
  MATERNITE_PATERNITE
  AUTRE
}

enum LeaveSubmissionSource {
  HR_DASHBOARD
  EMPLOYEE_WHATSAPP_FORM
}

enum MissionSubmissionSource {
  HR_DASHBOARD
  EMPLOYEE_WHATSAPP_FORM
}

/** Type de soumission publique (formulaire WhatsApp, sans session RH). */
enum PublicSubmissionType {
  LEAVE_REQUEST
  MISSION_REQUEST
}

/** Motif de sortie de l’entreprise (RH). */
enum DepartureReason {
  RESIGNATION // Démission
  END_OF_CONTRACT // Fin de contrat
  DISMISSAL // Licenciement
  ABANDONMENT // Abandon de poste
  INTERNSHIP_END // Fin de stage
}

/** Employé salarié ou stagiaire (pas d'heures sup, fin de stage automatique). */
enum EmployeeKind {
  EMPLOYEE
  INTERN
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * Entreprise cliente. Chaque donnée métier lui appartient (organizationId) et l'application
 * ne montre que les données de l'entreprise de l'adresse ouverte (sous-domaine, cf. src/lib/tenant.ts).
 */
model Organization {
  id         String      @id @default(cuid())
  /** Sous-domaine : « goldenbeans » → goldenbeans.<ROOT_DOMAIN>. L'entreprise par défaut répond aussi sur le domaine racine. */
  slug       String      @unique
  name       String
  /** Structures (marques) de l'entreprise, dans l'ordre d'affichage des logos. */
  structures Structure[]
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  users User[]
  employees Employee[]
  employeeWhatsappPhones EmployeeWhatsappPhone[]
  sites Site[]
  schedules Schedule[]
  attendanceRecords AttendanceRecord[]
  leaveRequests LeaveRequest[]
  missionOrderSequences MissionOrderSequence[]
  missions Mission[]
  fraudAttempts FraudAttempt[]
  holidays Holiday[]
  hrRemarks HrRemark[]
  auditLogs AuditLog[]
  publicSubmissionLogs PublicSubmissionLog[]
  internships Internship[]

  @@map("organizations")
}

model User {
  id              String     @id @default(cuid())
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id])
  supabaseAuthId  String     @unique @map("supabase_auth_id")
  email           String     @unique
  name            String
  role            Role       @default(HR)
  active          Boolean    @default(true)
  /** WhatsApp pour alertes RH (demandes employé, etc.) */
  whatsappPhone   String?    @unique @map("whatsapp_phone")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  auditLogs       AuditLog[]
  hrRemarks       HrRemark[]

  @@index([organizationId])
  @@map("users")
}

model Employee {
  id               String             @id @default(cuid())
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id])
  matricule        String
  firstName        String             @map("first_name")
  lastName         String             @map("last_name")
  service          String
  structure        Structure          @default(SCPB)
  kind             EmployeeKind       @default(EMPLOYEE)
  active           Boolean            @default(true)
  whatsappPhone    String?            @unique @map("whatsapp_phone")
  whatsappLinkedAt DateTime?          @map("whatsapp_linked_at")
  onboardingCode   String?            @unique @map("onboarding_code")
  onboardingExpiry DateTime?          @map("onboarding_expiry")
  siteId           String?            @map("site_id")
  site             Site?              @relation(fields: [siteId], references: [id])
  /** 2e zone de travail (optionnel) : pointage accepté dans la zone 1 ou la zone 2 */
  checkoutSiteId   String?            @map("checkout_site_id")
  checkoutSite     Site?              @relation("EmployeeCheckoutSite", fields: [checkoutSiteId], references: [id])
  departureDate    DateTime?          @map("departure_date") @db.Date
  departureReason  DepartureReason?   @map("departure_reason")
  departureNote    String?            @map("departure_note")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  attendances      AttendanceRecord[]
  leaveRequests    LeaveRequest[]
  missions         Mission[]
  fraudAttempts    FraudAttempt[]
  hrRemarks        HrRemark[]
  publicSubmissions PublicSubmissionLog[]
  whatsappPhones     EmployeeWhatsappPhone[]
  internship         Internship?
  supervisedInternships Internship[] @relation("InternshipSupervisor")

  @@unique([organizationId, matricule])
  @@map("employees")
}

/** Stage d'un employé de type INTERN : dates, école, encadrant, gratification. */
model Internship {
  id                String       @id @default(cuid())
  organizationId    String       @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id])
  employeeId        String       @unique @map("employee_id")
  employee          Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate         DateTime     @map("start_date") @db.Date
  endDate           DateTime     @map("end_date") @db.Date
  school            String
  fieldOfStudy      String?      @map("field_of_study")
  level             String?
  supervisorId      String?      @map("supervisor_id")
  supervisor        Employee?    @relation("InternshipSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  /** Gratification mensuelle (FCFA). */
  monthlyAllowance  Int?         @map("monthly_allowance")
  /** Rappel « fin de stage dans 7 jours » envoyé aux RH (remis à zéro si la date de fin change). */
  endReminderSentAt DateTime?    @map("end_reminder_sent_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([organizationId, endDate])
  @@map("internships")
}

model EmployeeWhatsappPhone {
  id         String   @id @default(cuid())
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id])
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  phone      String   @unique @map("phone")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([employeeId, phone])
  @@index([employeeId])
  @@index([organizationId])
  @@map("employee_whatsapp_phones")
}

model Site {
  id        String     @id @default(cuid())
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id])
  name      String
  centerLat Float      @map("center_lat")
  centerLng Float      @map("center_lng")
  radiusM   Int        @map("radius_m")
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  employees         Employee[]
  checkoutEmployees Employee[] @relation("EmployeeCheckoutSite")
  schedules         Schedule[]

  @@index([organizationId])
  @@map("sites")
}

model Schedule {
  id           String   @id @default(cuid())
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id])
  siteId       String   @map("site_id")
  site         Site     @relation(fields: [siteId], references: [id])
  startTime    String   @map("start_time")
  endTime      String   @map("end_time")
  closureTime  String   @map("closure_time")
  lateGraceMin Int      @default(0) @map("late_grace_min")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("schedules")
}

model AttendanceRecord {
  id              String          @id @default(cuid())
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id])
  employeeId      String          @map("employee_id")
  employee        Employee        @relation(fields: [employeeId], references: [id])
  date            DateTime        @db.Date
  checkInTime     DateTime?       @map("check_in_time")
  checkInStatus   CheckInStatus?  @map("check_in_status")
  checkInComment  String?         @map("check_in_comment")
  checkInLat      Float?          @map("check_in_lat")
  checkInLng      Float?          @map("check_in_lng")
  checkOutTime    DateTime?       @map("check_out_time")
  checkOutStatus  CheckOutStatus? @map("check_out_status")
  checkOutComment String?         @map("check_out_comment")
  checkOutLat     Float?          @map("check_out_lat")
  checkOutLng     Float?          @map("check_out_lng")
  breakStartTime  DateTime?       @map("break_start_time")
  breakEndTime    DateTime?       @map("break_end_time")
  breakDeductedMinutes Int?       @default(0) @map("break_deducted_minutes")
  breakMinutes    Int?            @default(0) @map("break_minutes")
  /** Motif si pause mesurée > durée attendue (60 min) */
  breakComment    String?         @map("break_comment")
  totalMinutes       Int?            @map("total_minutes")
  overtimeMinutes    Int?            @default(0) @map("overtime_minutes")
  overtimeStatus     OvertimeStatus? @map("overtime_status")
  overtimeReason     String?         @map("overtime_reason")
  overtimeValidatedBy String?        @map("overtime_validated_by")
  overtimeValidatedAt DateTime?      @map("overtime_validated_at")
  finalStatus        FinalStatus     @default(PRESENT) @map("final_status")
  /** Motif type de correction RH */
  correctionReason   String?         @map("correction_reason")
  /** Justificatif (URL Storage) */
  correctionDocument String?         @map("correction_document")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@unique([employeeId, date])
  @@index([organizationId])
  @@map("attendance_records")
}

model LeaveRequest {
  id               String               @id @default(cuid())
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id])
  employeeId       String               @map("employee_id")
  employee         Employee             @relation(fields: [employeeId], references: [id])
  startDate        DateTime             @map("start_date") @db.Date
  endDate          DateTime             @map("end_date") @db.Date
  reason           String
  absenceCategory  LeaveAbsenceCategory? @map("absence_category")
  notifyOrReplace  String?               @map("notify_or_replace")
  submissionSource LeaveSubmissionSource @default(HR_DASHBOARD) @map("submission_source")
  status           RequestStatus         @default(PENDING)
  document         String?
  approvedBy       String?               @map("approved_by")
  cancelledAt      DateTime?             @map("cancelled_at")
  cancelledBy      String?               @map("cancelled_by")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("leave_requests")
}

/** Compteur annuel pour les numéros d'ordre de mission (N/MM/AAAA). */
model MissionOrderSequence {
  year    Int
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id])
  lastSeq Int @default(0) @map("last_seq")

  @@id([organizationId, year])
  @@map("mission_order_sequences")
}

model Mission {
  id               String        @id @default(cuid())
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id])
  employeeId       String        @map("employee_id")
  employee         Employee      @relation(fields: [employeeId], references: [id])
  /** Numéro officiel ex. 3/06/2026 */
  orderNumber      String?       @map("order_number")
  startDate        DateTime      @map("start_date") @db.Date
  endDate          DateTime      @map("end_date") @db.Date
  reason           String
  location         String?
  transport        String?
  lodging          String?
  expenses         String?
  originStructure  Structure?    @map("origin_structure")
  hostStructure    Structure?    @map("host_structure")
  submissionSource MissionSubmissionSource @default(HR_DASHBOARD) @map("submission_source")
  daysCompleted    Int           @default(0) @map("days_completed")
  status           RequestStatus @default(PENDING)
  approvedBy       String?       @map("approved_by")
  cancelledAt      DateTime?     @map("cancelled_at")
  cancelledBy      String?       @map("cancelled_by")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@unique([organizationId, orderNumber])
  @@map("missions")
}

model FraudAttempt {
  id         String   @id @default(cuid())
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id])
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])
  timestamp  DateTime @default(now())
  lat        Float
  lng        Float
  distanceM  Float    @map("distance_m")
  type       String
  rawMessage String?  @map("raw_message")

  @@index([organizationId])
  @@map("fraud_attempts")
}

model Holiday {
  id        String   @id @default(cuid())
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id])
  name      String
  date      DateTime @db.Date
  recurring Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("holidays")
}

model HrRemark {
  id         String   @id @default(cuid())
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id])
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])
  category   String
  level      Int?
  content    String   @db.Text
  authorId   String   @map("author_id")
  author     User     @relation(fields: [authorId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("hr_remarks")
}

model AuditLog {
  id         String   @id @default(cuid())
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id])
  actorId    String   @map("actor_id")
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  entity     String
  entityId   String   @map("entity_id")
  beforeJson String?  @map("before_json") @db.Text
  afterJson  String?  @map("after_json") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("audit_logs")
}

/** Traçabilité des formulaires publics soumis par les employés (lien WhatsApp). */
model PublicSubmissionLog {
  id         String              @id @default(cuid())
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id])
  employeeId String              @map("employee_id")
  employee   Employee            @relation(fields: [employeeId], references: [id])
  type       PublicSubmissionType
  entity     String
  entityId   String              @map("entity_id")
  ipAddress  String?             @map("ip_address")
  userAgent  String?             @map("user_agent") @db.Text
  payloadJson String?            @map("payload_json") @db.Text
  createdAt  DateTime            @default(now()) @map("created_at")

  @@index([employeeId, createdAt])
  @@index([type, entityId])
  @@index([organizationId])
  @@map("public_submission_logs")
}
